  "GT-020": [
    {
      "doc_id": "kb-004",
      "content": "Email bị kẹt trong Outbox, Outlook báo Disconnected hoặc không đồng bộ với Exchange Server.\n1. Kiểm tra trạng thái kết nối góc dưới Outlook. 2. File → Account Settings → kiểm tra server settings. 3. Xóa email kẹt trong Outbox. 4. Repair OST: Account Settings → Data Files → Repair. 5. Tạo profile Outlook mới nếu vẫn lỗi.",
      "metadata": {
        "source_id": "kb-004",
        "source_type": "INTERNAL",
        "title": "Outlook không đồng bộ email / stuck sending",
        "snapshot_version": "enterprise-context-snapshot-v1.2",
        "content_hash": "7bbbd9acc00212029da94e43b91bb50e03d6eebab28b1e3b768fe21f2b0670c7",
        "provenance": "frozen KB fixture"
      }
    }
  ],
  "GT-021": [
    {
      "doc_id": "kb-033",
      "content": "Microsoft Teams hoặc Zoom không kết nối được cuộc họp, mic/camera không nhận, hoặc âm thanh bị vỡ.\n1. Kiểm tra permission mic/camera trong Windows Settings → Privacy. 2. Chọn đúng thiết bị audio trong Teams/Zoom settings. 3. Kiểm tra bandwidth: Teams cần tối thiểu 2Mbps. 4. Update Teams/Zoom lên phiên bản mới nhất. 5. Thử web browser thay vì app.",
      "metadata": {
        "source_id": "kb-033",
        "source_type": "INTERNAL",
        "title": "Teams/Zoom không hoạt động khi họp online",
        "snapshot_version": "enterprise-context-snapshot-v1.2",
        "content_hash": "f04ba1db14de346eaabfb7c172e08dea85bc8f25d7aba5863acc44b94551ecd4",
        "provenance": "frozen KB fixture"
      }
    }
  ],
  "GT-022": [
    {
      "doc_id": "kb-009",
      "content": "Máy tính của nhân viên chạy chậm bất thường, CPU/RAM cao, thời gian khởi động lâu.\n1. Kiểm tra Task Manager (Ctrl+Shift+Esc) xem process nào ngốn tài nguyên. 2. Disk Cleanup và disk defrag. 3. Kiểm tra virus bằng Windows Defender. 4. Tắt startup programs không cần thiết. 5. Nếu RAM <8GB, xem xét nâng cấp.",
      "metadata": {
        "source_id": "kb-009",
        "source_type": "INTERNAL",
        "title": "Máy tính chạy chậm / lag",
        "snapshot_version": "enterprise-context-snapshot-v1.2",
        "content_hash": "18c5aa931b03a2ac776858db5154446d63089363ec7bd1c99e8975ac4fe190fa",
        "provenance": "frozen KB fixture"
      }
    }
  ],
  "GT-023": [
    {
      "doc_id": "kb-001",
      "content": "Nhân viên báo lỗi không đăng nhập được VPN, thông báo lỗi authentication failed hoặc connection timeout khi kết nối VPN Cisco AnyConnect/FortiClient.\n1. Kiểm tra username/password VPN (thường khác email). 2. Xóa profile VPN cũ và tạo mới. 3. Kiểm tra firewall máy tính local. 4. Thử đổi network (4G thay WiFi). 5. Reset MFA app nếu dùng 2FA. 6. Liên hệ IT reset VPN account nếu vẫn lỗi.",
      "metadata": {
        "source_id": "kb-001",
        "source_type": "INTERNAL",
        "title": "Không kết nối được VPN công ty",
        "snapshot_version": "enterprise-context-snapshot-v1.2",
        "content_hash": "8c28aa90616450c1ff8bb86977d664cbc0cd9fbcd9e053e629b4e77de3e6d931",
