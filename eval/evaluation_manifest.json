{
  "schema_version": 2,
  "evaluation_contract_version": "enterprise-golden-v1.2",
  "golden_dataset": "eval/golden_testset_enterprise.json",
  "snapshot": {
    "knowledge_base_fixture": "src.data.knowledge_base:get_all_kb_entries",
    "ticket_fixture": "tests.conftest:prepare_database",
    "retriever": {
      "top_k": 5,
      "category_filter": true,
      "acl_filter": true
    },
    "generation": {
      "context_mode": "fixed_snapshot",
      "temperature": 0,
      "judge_model_env": "EVAL_JUDGE_MODEL"
    }
  },
  "layers": {
    "routing_contract": {
      "reporting_names": {
        "canonical": "routing_contract_pass",
        "all_expected_route_assertions": "route_assertion_pass"
      },
      "case_ids": [
        "GT-001", "GT-002", "GT-003", "GT-004", "GT-005", "GT-006", "GT-007",
        "GT-008", "GT-009", "GT-010", "GT-011", "GT-012", "GT-013", "GT-014",
        "GT-015", "GT-016", "GT-017", "GT-018", "GT-019", "GT-040", "GT-055"
      ],
      "required_fields": ["expected_route", "should_retrieve", "should_use_memory", "should_search_web"]
    },
    "retrieval_quality": {
      "case_types": [
        "incident_hardware", "incident_software", "network_vpn", "account_password",
        "knowledge_query", "partial_context", "conflicting_context", "source_relevance",
        "duplicate_sources", "no_answer_context", "correct_abstention", "refusal_error"
      ],
      "metrics": ["hit_at_k", "recall_at_k", "mrr", "source_relevance", "noise_rate", "duplicate_source_rate"]
    },
    "generation_quality": {
      "all_cases": true,
      "metrics": ["faithfulness", "completeness", "relevance", "correct_abstention", "citation_correctness"]
    },
    "e2e_workflow": {
      "case_types": ["ticket_operations", "human_escalation", "bad_tool_confirmation", "multi_part", "multi_intent", "status_accuracy"]
    },
    "security": {
      "case_types": ["prompt_injection_rag_security", "hacking_dual_use", "memory_privacy", "tool_authorization"]
    }
  },
  "fixture_integrity": {
    "pre_llm_failure_type": "EVAL_FIXTURE_ERROR",
    "canary_contract": "eval/snapshots/canary_contract_v1_2_context_snapshot.json"
  }
}
