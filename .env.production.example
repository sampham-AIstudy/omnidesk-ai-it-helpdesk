# ==============================================================================
# P-236 Help Desk — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on the production host and fill in secrets.
# NEVER COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL.

# Application Environment
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Demo Data Isolation (Strictly False in Production)
ENABLE_DEMO_SEED=false

# Initial Production Administrator Provisioning
# (Used only during first-time clean database bootstrap; ignored if admin exists)
INITIAL_ADMIN_EMAIL=admin@corp.example.com
INITIAL_ADMIN_USERNAME=it_admin
INITIAL_ADMIN_PASSWORD=<CHANGE_TO_HIGH_ENTROPY_PASSWORD_MIN_16_CHARS>
INITIAL_ADMIN_FULL_NAME=IT System Administrator

# Security & Authentication (MUST be >= 32 chars, 256-bit entropy random key)
JWT_SECRET=<CHANGE_TO_RANDOM_256_BIT_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Explicit CORS Whitelist (Wildcard '*' is strictly forbidden in production)
CORS_ORIGINS=https://helpdesk.corp.example.com,https://itsm.corp.example.com
NEXT_PUBLIC_API_URL=https://api.helpdesk.corp.example.com

# Database (Production SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/helpdesk.db

# Vector Database & Canonical Embedding Provenance
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=helpdesk_kb_multilingual_v2_sentence_transformer
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BACKEND=sentence_transformer
EMBEDDING_ALLOW_NETWORK_DOWNLOADS=false

# LLM Providers (At least one production provider key required)
MISTRAL_API_KEY=<CHANGE_TO_PRODUCTION_MISTRAL_API_KEY>
MISTRAL_CLASSIFIER_MODEL=mistral-small-2506
MISTRAL_RAG_MODEL=mistral-small-2506
MISTRAL_RUNBOOK_MODEL=codestral-2508
MISTRAL_FAST_CLASSIFIER_MODEL=ministral-3b-2512

# Optional Secondary Fallbacks
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# Observability & Monitoring
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
