# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Multi-Provider: Mistral -> OpenAI -> Ollama Local) ----
# Priority 1: Mistral API
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_CLASSIFIER_MODEL=mistral-small-2506
MISTRAL_RAG_MODEL=mistral-small-2506
MISTRAL_RUNBOOK_MODEL=codestral-2508
MISTRAL_FAST_CLASSIFIER_MODEL=ministral-3b-2512

# Priority 2: OpenAI API (Fallback nếu không có Mistral Key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Priority 3: Local Ollama Server (Fallback nếu không có bất kỳ Cloud API Key nào)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=helpdesk_kb_multilingual_v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Ngưỡng xử lý AI (PRD FR-09) ----
# >= 75%: đủ điều kiện xử lý bình thường/tự đóng nếu các rule an toàn khác cho phép
# 60–74%: cảnh báo, End User có thể yêu cầu hỗ trợ người thật
# < 60%: bắt buộc HITL/xử lý thủ công
CONFIDENCE_THRESHOLD_AUTO_CLOSE=0.75
CONFIDENCE_THRESHOLD_WARNING=0.60
CONFIDENCE_THRESHOLD_HITL=0.60

# ---- LLM Cache ----
# Preferred: standard Redis protocol. Credentials in this URL are never
# returned by /health or written to application logs.
# REDIS_URL=rediss://user:password@redis-host:6380/0
REDIS_CACHE_TTL=3600

# Optional fallback for serverless Upstash deployments:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
