# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Multi-Provider: Mistral -> OpenAI -> Ollama Local) ----
# Priority 1: Mistral API
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_CLASSIFIER_MODEL=mistral-small-2506
MISTRAL_RAG_MODEL=mistral-small-2506
MISTRAL_RUNBOOK_MODEL=codestral-2508
MISTRAL_FAST_CLASSIFIER_MODEL=ministral-3b-2512

# Priority 2: OpenAI API (Fallback nếu không có Mistral Key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini LLM fallback and red-team generation only. Keep this separate from
# GOOGLE_API_KEY, which is reserved for the Gemini safety guardrail.
GEMINI_API_KEY=

# ---- Optional external LLM judge for synthetic golden evaluations only ----
# Never point this at production tickets or confidential KB content. Explicit
# EVAL_JUDGE_* values take priority; otherwise NVIDIA_API_KEY uses NIM below.
EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
# Hosted large judge models can take longer than the production API budget.
EVAL_JUDGE_TIMEOUT_SECONDS=90

# Priority 3: Local Ollama Server (Fallback nếu không có bất kỳ Cloud API Key nào)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=helpdesk_kb_multilingual_v2_sentence_transformer
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Keep retrieval reliable in offline deployments; set true only during an
# approved model bootstrap where Hugging Face downloads are permitted.
EMBEDDING_ALLOW_NETWORK_DOWNLOADS=false
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- External Web Research ----
# The assistant first searches the ACL-scoped internal KB.  A provider is used
# only for low-confidence/current/vendor questions; PII and secrets are redacted
# before any external request. Set false to operate with internal RAG only.
WEB_RESEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo_html
WEB_RESEARCH_TIMEOUT_SECONDS=6
WEB_RESEARCH_MAX_RESULTS=4
WEB_RESEARCH_MIN_RAG_SCORE=0.55

# ---- Semantic Duplicate Ticket Detection ----
DUPLICATE_HIGH_THRESHOLD=0.85
DUPLICATE_POSSIBLE_THRESHOLD=0.62
DUPLICATE_SEARCH_CANDIDATES=24
DUPLICATE_SPAM_WINDOW_MINUTES=30

# ---- Zero-Mem episodic ticket/conversation retrieval ----P
ZERO_MEM_ENABLED=true
ZERO_MEM_PRIMARY_VIEW_WEIGHT=0.60
ZERO_MEM_PRIMARY_CANDIDATES=8
ZERO_MEM_FINAL_EVIDENCE=5
ZERO_MEM_NEIGHBOR_WINDOW=1

# ---- Short-term recent conversation context (separate from Zero-Mem) ----
# Scoped to the explicit workspace conversation or ticket only. Each old
# message is capped so it cannot displace the current user question.
CHAT_RECENT_HISTORY_MESSAGES=8
TICKET_RECENT_HISTORY_MESSAGES=5
CHAT_RECENT_HISTORY_MESSAGE_CHARS=1200
TICKET_RECENT_HISTORY_MESSAGE_CHARS=1200

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- OpenTelemetry ----
# Host-run backend: localhost:4317. Docker Compose overrides this with
# otel-collector:4317 for the backend service.
# Keep sampling configurable through the standard OTEL_TRACES_SAMPLER variables;
# the all-sampled setting below is appropriate for development/demo only.
# Keep this false for a host-run app until an OTLP Collector or observability
# provider endpoint is available. Enable it by setting this to true together
# with OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=helpdesk-ai-agent
OTEL_SERVICE_VERSION=1.0.0
# Optional stable deployment identifiers. Never use user, tenant, or ticket data.
OTEL_SERVICE_NAMESPACE=
OTEL_SERVICE_INSTANCE_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- Ngưỡng xử lý AI (PRD FR-09) ----
# >= 75%: đủ điều kiện xử lý bình thường/tự đóng nếu các rule an toàn khác cho phép
# 60–74%: cảnh báo, End User có thể yêu cầu hỗ trợ người thậtP
# < 60%: bắt buộc HITL/xử lý thủ công
CONFIDENCE_THRESHOLD_AUTO_CLOSE=0.75
CONFIDENCE_THRESHOLD_WARNING=0.60
CONFIDENCE_THRESHOLD_HITL=0.60

# ---- LLM Cache ----
# Preferred: standard Redis protocol. Credentials in this URL are never
# returned by /health or written to application logs.
# REDIS_URL=rediss://user:password@redis-host:6380/0
REDIS_CACHE_TTL=3600

# Optional fallback for serverless Upstash deployments:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Browser-visible URL, set this to https://api.example.com (or, for a temporary
# cloud smoke test, http://YOUR_SERVER_IP:8000) before `docker compose build`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Security & Guardrail Integrations ----
NVIDIA_API_KEY=
# Used only by eval/ragas_assessment_eval.py as the fallback external judge.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default prioritizes a responsive automated quality gate. Set 3.3-70B only
# for offline benchmark runs where higher latency is acceptable.
NVIDIA_EVAL_JUDGE_MODEL=meta/llama-3.1-8b-instruct
GROQ_API_KEY=
# Gemini Safety Judge / output guardrail only (not the LLM fallback).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=0

RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

BLOCK_RATE_THRESHOLD=0.5
JUDGE_FAIL_RATE_THRESHOLD=0.3

LAKERAGUARD_API_KEY=
VIRUSTOTAL_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_SAFE_BROWSING_API=
OPENAI_MODERATION_API=
